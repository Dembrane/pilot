{
  "mypy.runUsingActiveInterpreter": true,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.useTabStops": true,
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.useTabStops": true,
    "editor.tabSize": 2
  },
  "restoreTerminals.runOnStartup": false,
  "restoreTerminals.terminals": [
    {
      "splitTerminals": [
        {
          "name": "server",
          "commands": ["cd server", "./run.sh"]
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "worker",
          "commands": ["cd server", "./run-worker.sh"]
        }
      ]
    },
    {
      "splitTerminals": [
        {
          "name": "admin-dashboard",
          "commands": ["cd frontend", "yarn dev"]
        },
        {
          "name": "participant-portal",
          "commands": ["cd frontend", "yarn participant:dev"]
        }
      ]
    }
  ]
}
