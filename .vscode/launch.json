  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Server",
      "type": "debugpy",
      "request": "launch",
      "module": "dembrane.main",
      "cwd": "${workspaceFolder}/server"
    },
    {
      "name": "image_utils",
      "type": "debugpy",
      "request": "launch",
      "module": "dembrane.image_utils",
      "cwd": "${workspaceFolder}/server"
    },
    {
      "name": "quote_utils",
      "type": "debugpy",
      "request": "launch",
      "module": "dembrane.quote_utils",
      "cwd": "${workspaceFolder}/server"
    }
  ]
}
